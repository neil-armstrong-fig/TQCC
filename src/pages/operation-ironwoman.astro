---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import { getLastUpdated } from "../lib/git-date";
import DonationWidget from "../components/ironwoman/DonationWidget.astro";
import { getDonationTotal } from "../lib/givestar";
import walesMedal from "../assets/images/ironwoman/wales-medal.jpeg";
import leedsFinish from "../assets/images/ironwoman/leeds-finish.jpeg";
import weymouthRun from "../assets/images/ironwoman/weymouth-run.jpeg";
import tqccCafeStop from "../assets/images/ironwoman/tqcc-cafe-stop.jpeg";
import portavoeSwimTraining from "../assets/images/ironwoman/portavoe-swim-training.jpeg";
import preSwanseaClubRide from "../assets/images/ironwoman/pre-swansea-club-ride.jpeg";
import weymouthBikeGroup from "../assets/images/ironwoman/weymouth-bike-group.jpeg";
import weymouthBike from "../assets/images/ironwoman/weymouth-bike.jpeg";
import weymouthMedal from "../assets/images/ironwoman/weymouth-medal.jpeg";

const publishDate = new Date("2026-09-29T00:00:00Z");
const lastUpdated = getLastUpdated("src/pages/operation-ironwoman.astro") ?? publishDate.toISOString();

const total = await getDonationTotal();
const asOfDisplay = total.asOf.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });

const donateUrl = "https://givestar.io/gs/operation-ironwoman-68905";
const instagramUrl = "https://www.instagram.com/operationironwoman";
const linkedinUrl = "https://uk.linkedin.com/in/emily-bond-3b2a0321b";
const anyGivenRundayUrl = "https://open.spotify.com/episode/6KyM4rUO2sCAXgFNYJV7fl";
const runningRulesUrl = "https://podcasts.apple.com/gb/podcast/161-operation-ironwoman-with-emily-bond-from-leg/id1670366028?i=1000752820287";
const offlineDonations = 198;
const pageTitle = "Operation Ironwoman: Emily Bond’s UK IRONMAN Story | TQCC";
const pageDescription = "Emily Bond made history with Operation Ironwoman, completing all five UK IRONMAN races in one 2026 season with a £10,000 target for four charities.";

const races = [
  { race: "Race 1", name: "IRONMAN 70.3 Bolton", date: "7 June 2026", result: "06:34:55" },
  { race: "Race 2", name: "IRONMAN 70.3 Swansea", date: "12 July 2026", result: "07:07:50" },
  { race: "Race 3", name: "IRONMAN Leeds", date: "16 August 2026", result: "13:48:57" },
  { race: "Race 4", name: "IRONMAN Wales, Tenby", date: "13 September 2026", result: "16:03:59" },
  { race: "Race 5", name: "IRONMAN 70.3 Weymouth", date: "20 September 2026", result: "06:55:57" },
];

const gallery = [
  {
    src: walesMedal,
    alt: "Emily Bond holding her medal and ceremonial key after completing IRONMAN Wales",
    caption: "After completing IRONMAN Wales in Tenby.",
  },
  {
    src: leedsFinish,
    alt: "Emily Bond reacting emotionally beneath the IRONMAN Leeds finish arch",
    caption: "An emotional finish at IRONMAN Leeds.",
  },
  {
    src: tqccCafeStop,
    alt: "Emily Bond and two Titanic Quarter Cycling Club riders taking a break at a cafe",
    caption: "A TQCC cafe stop during a club ride while Emily was ill.",
  },
  {
    src: portavoeSwimTraining,
    alt: "Emily Bond in her wetsuit after an open-water swim training session at Portavoe Beach",
    caption: "Open-water swim training at Portavoe Beach.",
  },
  {
    src: preSwanseaClubRide,
    alt: "Emily Bond on a Titanic Quarter Cycling Club training ride before IRONMAN 70.3 Swansea",
    caption: "A TQCC club ride before IRONMAN 70.3 Swansea.",
  },
  {
    src: weymouthBikeGroup,
    alt: "Emily Bond riding with a group on the IRONMAN 70.3 Weymouth bike course",
    caption: "Riding with the group at IRONMAN 70.3 Weymouth.",
  },
  {
    src: weymouthBike,
    alt: "Emily Bond racing on the bike course at IRONMAN 70.3 Weymouth",
    caption: "On the bike at IRONMAN 70.3 Weymouth.",
  },
  {
    src: weymouthMedal,
    alt: "Emily Bond embracing her best friend at the IRONMAN 70.3 Weymouth finish line",
    caption: "Emily's best friend presents her Weymouth medal after supporting her at every race.",
  },
];

const charities = [
  {
    name: "Cycle Against Suicide",
    url: "https://www.cycleagainstsuicide.com/",
    reason: "Gave Emily a space to talk and share with others.",
  },
  {
    name: "Childline",
    url: "https://www.childline.org.uk/",
    reason: "A place to turn to when she was younger and facing tough times.",
  },
  {
    name: "Extern Crisis & Counselling",
    url: "https://www.extern.org/",
    reason: "Provided support during one of the toughest periods of her life.",
  },
  {
    name: "St John Ambulance Cymru",
    url: "https://www.sjacymru.org.uk/",
    reason: "Supported Emily's IRONMAN 70.3 Swansea entry alongside its first aid work across Wales.",
  },
];

const relatedLinks = [
  {
    name: "Operation Ironwoman on Instagram",
    description: "Follow Emily's updates and see more from the challenge.",
    url: instagramUrl,
  },
  {
    name: "Emily Bond on LinkedIn",
    description: "Emily's professional profile and Operation Ironwoman updates.",
    url: linkedinUrl,
  },
  {
    name: "Any Given Runday podcast",
    description: "Emily discusses Operation Ironwoman, endurance and personal growth.",
    url: anyGivenRundayUrl,
  },
  {
    name: "The Running Rules Podcast",
    description: "Emily shares the story behind her challenge and return to running.",
    url: runningRulesUrl,
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords="Operation Ironwoman, Emily Bond, UK IRONMAN, every UK IRONMAN race, women in triathlon, charity endurance challenge"
  image={weymouthRun.src}
  type="article"
  publishDate={publishDate}
  lastUpdated={lastUpdated}
>
  <JsonLd
    type="BlogPosting"
    title="Operation Ironwoman: Emily Bond’s UK IRONMAN Story"
    description={pageDescription}
    datePublished={publishDate}
    dateModified={lastUpdated}
    image={weymouthRun.src}
    aboutPerson={{
      name: "Emily Bond",
      description: "Northern Ireland endurance athlete, aerospace engineering PhD researcher and creator of Operation Ironwoman.",
      sameAs: [instagramUrl, linkedinUrl],
      subjectOf: [
        {
          name: "Emily Bond: Operation Ironwoman, Performing TEDx Talks, Learning Personal Growth from Rocket Science",
          url: anyGivenRundayUrl,
        },
        {
          name: "Operation Ironwoman with Emily Bond, from leg surgery to tackling every UK IRONMAN race in one season",
          url: runningRulesUrl,
        },
      ],
    }}
  />

  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4">
      <h1 class="text-4xl font-bold mb-8">Operation Ironwoman</h1>

      <p class="text-xl text-tqcc-gray leading-relaxed mb-8">
        TQCC member Emily Bond became the first woman to complete every UK
        IRONMAN race in a single season. Through Operation Ironwoman, she is
        aiming to raise <strong class="text-tqcc-black">£10,000</strong> for four charities.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 mb-12">
        <a
          href={donateUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block text-center bg-tqcc-yellow text-tqcc-black font-bold px-6 py-3 rounded-lg hover:bg-tqcc-yellow-dark transition-colors"
        >
          Donate now &rarr;
        </a>
        <a
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block text-center border border-tqcc-pink text-tqcc-pink font-bold px-6 py-3 rounded-lg hover:bg-tqcc-pink/10 transition-colors"
        >
          Follow Operation Ironwoman on Instagram
        </a>
      </div>

      <figure class="mb-12">
        <Image
          src={weymouthRun}
          alt="Emily Bond waving while running along the seafront at IRONMAN 70.3 Weymouth"
          class="rounded-lg shadow-lg w-full"
          loading="eager"
          fetchpriority="high"
          widths={[640, 1024, 1600]}
          sizes="100vw"
        />
        <figcaption class="mt-2 text-sm text-tqcc-gray text-center">
          The final race, IRONMAN 70.3 Weymouth.
        </figcaption>
      </figure>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
        <div class="bg-tqcc-gray-light p-5 rounded-lg text-center">
          <span class="text-2xl font-bold text-tqcc-pink">5 Races</span>
          <p class="mt-1 text-tqcc-gray text-sm">One season, every UK IRONMAN</p>
        </div>
        <div class="bg-tqcc-gray-light p-5 rounded-lg text-center">
          <span class="text-2xl font-bold text-tqcc-pink">£10,000</span>
          <p class="mt-1 text-tqcc-gray text-sm">Fundraising target</p>
        </div>
        <div class="bg-tqcc-gray-light p-5 rounded-lg text-center">
          <span class="text-2xl font-bold text-tqcc-pink">4 Charities</span>
          <p class="mt-1 text-tqcc-gray text-sm">Every penny shared between them</p>
        </div>
      </div>

      <DonationWidget
        amount={total.amount}
        giftAid={total.giftAid}
        offline={offlineDonations}
        target={10000}
        asOf={asOfDisplay}
        donateUrl={donateUrl}
      />

      <h2 class="text-2xl font-bold mb-4">The challenge</h2>
      <p class="text-tqcc-gray mb-4">
        A full IRONMAN covers <span class="distance-string" data-distance="140.6 miles" data-kilometers="226 km">140.6 miles</span>: a swim of <span class="distance-string" data-distance="2.4 miles" data-kilometers="3.8 km">2.4 miles</span>, a bike ride of <span class="distance-string" data-distance="112 miles" data-kilometers="180 km">112 miles</span> and a run of <span class="distance-string" data-distance="26.2 miles" data-kilometers="42.2 km">26.2 miles</span>, completed back to back. In 2026, Emily completed all five of the UK's
        IRONMAN races in a single season and became the first woman to achieve
        the feat. She calls it
        <strong class="text-tqcc-black">Operation Ironwoman</strong>.
      </p>
      <p class="text-tqcc-gray mb-8">
        Emily is an aerospace engineering PhD student and endurance athlete.
        Her season began at IRONMAN 70.3 Bolton and concluded at IRONMAN 70.3
        Weymouth, just one week after she completed IRONMAN Wales in Tenby.
      </p>

      <div class="bg-tqcc-yellow/10 border-l-4 border-tqcc-yellow p-6 rounded-r-lg mb-12">
        <p class="text-tqcc-gray italic">
          &ldquo;It all started with me seeing what I could do after my surgery,
          but it's become so much more.&rdquo;
        </p>
        <p class="text-sm text-tqcc-gray mt-2">Emily Bond</p>
      </div>

      <h2 class="text-2xl font-bold mb-4">Emily Bond's story</h2>
      <p class="text-tqcc-gray mb-4">
        In 2018, major surgery on both of Emily's legs left her unable to run for
        around two and a half years. Completing an IRONMAN seemed impossible.
      </p>
      <p class="text-tqcc-gray mb-4">
        In October 2024 she signed up for her first 5k, which she ran in April
        2025. She then bought a second-hand bike from a friend and entered her
        first triathlon. After just four months of unstructured training she
        completed IRONMAN 70.3 Weymouth, and the idea for Operation Ironwoman
        was born.
      </p>
      <p class="text-tqcc-gray mb-12">
        At IRONMAN Leeds she covered the <span class="distance-string" data-distance="112 miles" data-kilometers="180 km">112 miles</span> bike course and the full marathon
        run in a time of 13 hours 48 minutes 57 seconds.
      </p>

      <h2 class="text-2xl font-bold mb-4">Emily Bond, profiles and interviews</h2>
      <p class="text-tqcc-gray mb-6">
        Follow Emily and hear her tell the story behind Operation Ironwoman in her own words.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
        {relatedLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="block border border-gray-200 rounded-lg p-5 hover:border-tqcc-pink hover:shadow-md transition-all"
          >
            <h3 class="font-bold text-tqcc-pink">{link.name}</h3>
            <p class="text-tqcc-gray text-sm mt-2">{link.description}</p>
          </a>
        ))}
      </div>

      <h2 class="text-2xl font-bold mb-4">The races</h2>
      <p class="text-tqcc-gray mb-6">Five starts, five finishes, all in one season.</p>
      <div class="space-y-3 mb-12">
        {races.map((r) => (
          <div class="border border-gray-200 rounded-lg p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <span class="text-tqcc-pink font-semibold text-sm">{r.race}</span>
              <h3 class="font-bold">{r.name}</h3>
            </div>
            <div class="sm:text-right text-sm text-tqcc-gray">
              <p>{r.date}</p>
              <p>Finish time: {r.result}</p>
            </div>
          </div>
        ))}
      </div>

      <h2 class="text-2xl font-bold mb-4">The journey</h2>
      <p class="text-tqcc-gray mb-6">
        From club rides and open-water training to five finish lines across the UK.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-12 items-start">
        {gallery.map((photo) => (
          <figure class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
            <Image
              src={photo.src}
              alt={photo.alt}
              class="w-full h-auto"
              loading="lazy"
              widths={[400, 720]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            />
            <figcaption class="p-3 text-sm text-tqcc-gray">{photo.caption}</figcaption>
          </figure>
        ))}
      </div>

      <h2 class="text-2xl font-bold mb-4">Who is Emily raising money for?</h2>
      <p class="text-tqcc-gray mb-6">
        Each of the four charities has played a part in Emily's own life.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
        {charities.map((charity) => (
          <a
            href={charity.url}
            target="_blank"
            rel="noopener noreferrer"
            class="block border border-gray-200 rounded-lg p-6 hover:border-tqcc-pink hover:shadow-md transition-all"
          >
            <h3 class="text-lg font-bold text-tqcc-pink">{charity.name}</h3>
            <p class="text-tqcc-gray text-sm mt-2">{charity.reason}</p>
          </a>
        ))}
      </div>

      <div class="bg-tqcc-black text-white p-8 rounded-lg text-center">
        <h2 class="text-2xl font-bold text-tqcc-yellow mb-4">
          Support Emily
        </h2>
        <p class="text-white/80 mb-4">
          Every donation, big or small, helps Emily reach her target and
          supports four brilliant charities. Follow Operation Ironwoman on
          Instagram to celebrate the completed challenge and see what comes next.
        </p>
        <a
          href={donateUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-tqcc-yellow text-tqcc-black font-bold px-6 py-2 rounded-lg hover:bg-tqcc-yellow-dark transition-colors"
        >
          Donate on Givestar &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
