---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import { getLastUpdated } from "../lib/git-date";
import { getPublicImage } from "../lib/image-size";

const events = await getCollection("events");
const event = events.find((e) => e.id === "summer-solstice-sportive-2026")!;
const { Content } = await render(event);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const posterSize = event.data.image ? await getPublicImage(event.data.image) : {};
const eventDate = event.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const eventTime = event.data.date.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" });

const registrationUrl = "https://www.entrycentral.com/tqccsportive26";
const lastUpdated = getLastUpdated("src/pages/sportive.astro");

// Route + Strava link.
// 2026 uses a rerouted course due to road conditions on the original route.
// To swap back to the original route next year, comment out the active lines
// below and uncomment the "original route" lines.
const routeGpxFile = "sportive-route-2026-reroute.gpx";
const stravaRouteUrl = "https://www.strava.com/routes/3499699149342567630?utm_medium=web_embed&utm_source=route_embed&strava_deeplink_url=strava%3A%2F%2Froutes%2F3499699149342567630";
// const routeGpxFile = "sportive-route.gpx"; // original route
// const stravaRouteUrl = "https://www.strava.com/routes/2960499863763510476"; // original route

const routeGpxUrl = `${baseUrl}/gpx/${routeGpxFile}`;
---

<BaseLayout
  title="Belfast Cycling Sportive 2026 — Summer Solstice Sportive | TQCC"
  description="Join the 2026 Belfast cycling sportive, a Friday evening ride through the Belfast hills, open to all abilities. 38 miles, hot food at the finish. The TQCC Summer Solstice Sportive is Belfast's only evening sportive event."
  keywords="belfast sportive, belfast cycling sportive, cycling sportive belfast, sportive northern ireland, summer solstice sportive, belfast cycling event, TQCC sportive"
  lastUpdated={lastUpdated}
>
  <JsonLd
    type="Event"
    title="Belfast Summer Solstice Sportive 2026 — TQCC Cycling Sportive"
    description="The Titanic Quarter Cycling Club Summer Solstice Sportive, a Friday evening Belfast cycling sportive through the Belfast hills. Open to all abilities, approximately 38 miles with hot food at the finish."
    eventDate={event.data.date}
    location={event.data.location}
    eventImage={event.data.image}
    eventUrl={registrationUrl}
  />

  <!-- Hero -->
  <section class="bg-tqcc-black text-white py-16">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <p class="text-tqcc-pink-light font-semibold uppercase tracking-widest mb-3">Friday Evening Sportive</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-tqcc-yellow mb-4">Belfast Summer Solstice Sportive 2026</h1>
      <p class="text-xl text-white/80 max-w-4xl mx-auto leading-relaxed mb-8">
        Friday evening cycling sportive in Belfast, open to all abilities.
        TQCC members and non-members welcome. Great roads, great people, and hot food at the finish.
      </p>
      <a href={registrationUrl} target="_blank" rel="noopener noreferrer" class="inline-block bg-tqcc-pink text-white font-bold text-lg px-10 py-4 rounded-lg cursor-pointer hover:bg-tqcc-pink/80 transition-colors">
        Register Now
      </a>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4">

      <!-- Sportive poster -->
      {event.data.image && (
        <div class="mb-12 mx-auto" style="max-width: 864px;">
          <a href={registrationUrl} target="_blank" rel="noopener noreferrer">
            <img
              src={`${baseUrl}${event.data.image}`}
              alt="Summer Solstice Sportive 2026 poster"
              width={posterSize.width}
              height={posterSize.height}
              decoding="async"
              class="w-full h-auto rounded-lg shadow-lg hover:shadow-xl transition-shadow"
            />
          </a>
        </div>
      )}

      <!-- Key details cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
        <div class="text-center p-5 bg-tqcc-gray-light rounded-lg">
          <span class="text-2xl font-bold text-tqcc-pink">Fri {eventDate}</span>
          <p class="mt-1 text-sm text-tqcc-gray">Friday Evening</p>
        </div>
        <div class="text-center p-5 bg-tqcc-gray-light rounded-lg">
          <span class="distance-string text-2xl font-bold text-tqcc-pink" data-distance="38.5 miles">38 miles</span>
          <p class="mt-1 text-sm text-tqcc-gray">Distance</p>
        </div>
        <div class="text-center p-5 bg-tqcc-gray-light rounded-lg">
          <span class="text-2xl font-bold text-tqcc-pink">{eventTime}</span>
          <p class="mt-1 text-sm text-tqcc-gray">Ride Out</p>
        </div>
<div class="text-center p-5 bg-tqcc-gray-light rounded-lg">
          <span class="text-2xl font-bold text-tqcc-pink">All</span>
          <p class="mt-1 text-sm text-tqcc-gray">Abilities Welcome</p>
        </div>
      </div>

      <div class="prose prose-lg max-w-none">
        <Content />
      </div>

      <!-- Route Map -->
      <div class="mt-2 mb-12">
        <h3 class="text-xl font-bold mb-4">Route Map</h3>
        <div id="sportive-map" style="height: 450px; width: 100%;" class="rounded-lg shadow-lg z-0"></div>
        <div id="elevation-chart" class="mt-2 rounded-lg overflow-hidden"></div>
        <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-3 mt-4">
          <a
            href={routeGpxUrl}
            download="tqcc-summer-solstice-sportive-2026.gpx"
            class="inline-flex items-center justify-center gap-2 bg-tqcc-black text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-tqcc-black/80 transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Download GPX
          </a>
          <a
            href={stravaRouteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-[#FC4C02] text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-[#FC4C02]/80 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169" /></svg>
            View on Strava
          </a>
        </div>
      </div>

      <!-- Registration CTA -->
      <div class="mt-12 bg-tqcc-black text-white p-8 rounded-lg text-center">
        <h2 class="text-2xl font-bold text-tqcc-yellow mb-4">Ready to Ride?</h2>
        <p class="text-white/80 mb-4">
          Secure your place on the Friday evening Summer Solstice Sportive.
        </p>
        <a href={registrationUrl} target="_blank" rel="noopener noreferrer" class="inline-block bg-tqcc-yellow text-tqcc-black font-bold px-6 py-2 rounded-lg cursor-pointer hover:bg-tqcc-yellow/80 transition-colors">
          Register Now
        </a>
      </div>

    </div>
  </section>

  <style is:global>
    .elevation-detached {
      font-family: inherit;
    }
    .elevation-detached .mouse-focus-line {
      stroke: #E91E8C;
    }
    #elevation-chart .elevation-summary,
    #elevation-chart .elevation-summary * {
      display: none !important;
      height: 0 !important;
      overflow: hidden !important;
    }
    .magenta-theme .area {
      --ele-area: #E91E8C !important;
      fill: #E91E8C !important;
      stroke: #E91E8C !important;
    }
  </style>
  <script is:inline define:vars={{ routeGpxUrl }}>
    // Leaflet, d3 and the elevation plugin are large and the map is below the fold,
    // so only fetch them when the map is about to scroll into view.
    var MAP_STYLES = [
      "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css",
      "https://unpkg.com/@raruto/leaflet-elevation/dist/leaflet-elevation.css",
    ];
    var MAP_SCRIPTS = [
      "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js",
      "https://unpkg.com/d3@7.9.0/dist/d3.min.js",
      "https://unpkg.com/@raruto/leaflet-elevation/dist/leaflet-elevation.js",
    ];

    function loadScript(src) {
      return new Promise(function (resolve, reject) {
        var el = document.createElement("script");
        el.src = src;
        el.onload = resolve;
        el.onerror = reject;
        document.head.appendChild(el);
      });
    }

    function loadMapLibraries() {
      MAP_STYLES.forEach(function (href) {
        var link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = href;
        document.head.appendChild(link);
      });
      // Scripts depend on each other, so load them in order.
      return MAP_SCRIPTS.reduce(function (chain, src) {
        return chain.then(function () { return loadScript(src); });
      }, Promise.resolve());
    }

    document.addEventListener("DOMContentLoaded", function () {
      var mapEl = document.getElementById("sportive-map");
      if (!mapEl) return;

      function start() {
        loadMapLibraries().then(initMap).catch(function (err) {
          console.error("Failed to load route map", err);
        });
      }

      if ("IntersectionObserver" in window) {
        var observer = new IntersectionObserver(function (entries) {
          if (entries.some(function (e) { return e.isIntersecting; })) {
            observer.disconnect();
            start();
          }
        }, { rootMargin: "400px 0px" });
        observer.observe(mapEl);
      } else {
        start();
      }
    });

    function initMap() {
      var gpxUrl = routeGpxUrl;
      var map = L.map("sportive-map", { scrollWheelZoom: false }).setView([54.56, -5.94], 11);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 18,
      }).addTo(map);

      var currentElevation = null;

      function getIsImperial() {
        try {
          return localStorage.getItem("tqcc-distance-unit") !== "km";
        } catch (e) {
          return true;
        }
      }

      function buildElevation() {
        if (currentElevation) {
          currentElevation.remove();
          currentElevation = null;
          // Clear the chart container
          var chartDiv = document.getElementById("elevation-chart");
          if (chartDiv) chartDiv.innerHTML = "";
        }

        currentElevation = L.control.elevation({
          detached: true,
          elevationDiv: "#elevation-chart",
          height: 140,
          autofitBounds: true,
          collapsed: false,
          closeBtn: false,
          summary: false,
          slope: false,
          speed: false,
          acceleration: false,
          time: false,
          legend: false,
          almostOver: true,
          imperial: getIsImperial(),
          ruler: false,
          distanceMarkers: { lazy: false, distance: false, direction: false },
          edgeScale: false,
          theme: "magenta-theme",
          polyline: {
            color: "#E91E8C",
            weight: 4,
            opacity: 0.85,
          },
        }).addTo(map);

        currentElevation.load(gpxUrl);
      }

      buildElevation();

      window.addEventListener("unit-change", function () {
        buildElevation();
      });
    }
  </script>
</BaseLayout>
