---
import BaseLayout from "../layouts/BaseLayout.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Members"
  description="TQCC members area — access club routes, the route builder, and members-only content for Titanic Quarter Cycling Club in Belfast."
>
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-4">
      <!-- Password gate -->
      <div id="password-gate" class="text-center py-20">
        <h1 class="text-4xl font-bold mb-4">Members Area</h1>
        <p class="text-tqcc-gray mb-8">
          Enter the club password to access this page.
        </p>
        <form id="password-form" class="max-w-sm mx-auto">
          <div class="relative">
            <input
              type="password"
              id="password-input"
              placeholder="Password"
              class="w-full px-4 py-3 pr-12 border border-gray-300 rounded-lg text-center text-lg focus:outline-none focus:ring-2 focus:ring-tqcc-yellow"
            />
            <button
              type="button"
              id="toggle-password"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 focus:outline-none"
              aria-label="Toggle password visibility"
            >
              <svg
                id="eye-open"
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                ></path>
              </svg>
              <svg
                id="eye-closed"
                class="w-6 h-6 hidden"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"
                ></path>
              </svg>
            </button>
          </div>
          <button
            type="submit"
            class="mt-4 w-full bg-tqcc-yellow text-tqcc-black font-bold px-6 py-3 rounded-lg hover:bg-tqcc-yellow-dark transition-colors"
          >
            Enter
          </button>
          <p id="error-message" class="mt-3 text-red-500 text-sm hidden">
            Incorrect password. Please try again.
          </p>
        </form>
      </div>

      <!-- Protected content (hidden until authenticated) -->
      <div id="members-content" class="hidden">
        <h1 class="text-4xl font-bold mb-8">Members Area</h1>

        <div class="prose prose-lg max-w-none mb-8">
          <p class="text-xl text-tqcc-gray leading-relaxed">
            Welcome to the TQCC members-only area.
          </p>
        </div>

        <div class="space-y-4">
          <!-- Club Routes CTA -->
          <div
            class="border border-gray-200 rounded-lg p-6 bg-gray-50 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
          >
            <div>
              <h2 class="text-xl font-bold mb-1">Club Routes</h2>
              <p class="text-tqcc-gray text-sm">
                Browse curated routes organised by pace group. Filter by
                distance and elevation to find the perfect ride.
              </p>
            </div>
            <a
              href={`${baseUrl}/members/routes`}
              class="inline-block bg-tqcc-yellow text-tqcc-black font-bold px-6 py-3 rounded-lg hover:bg-tqcc-yellow-dark transition-colors whitespace-nowrap"
            >
              Browse Routes &rarr;
            </a>
          </div>

          <!-- Route Builder CTA -->
          <div
            class="border border-gray-200 rounded-lg p-6 bg-gray-50 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
          >
            <div>
              <h2 class="text-xl font-bold mb-1">Route Builder</h2>
              <p class="text-tqcc-gray text-sm">
                Generate custom loop routes on quiet roads for group rides. Set
                your distance, direction, and download a GPX file.
              </p>
            </div>
            <a
              href={`${baseUrl}/members/route-builder`}
              class="inline-block bg-tqcc-yellow text-tqcc-black font-bold px-6 py-3 rounded-lg hover:bg-tqcc-yellow-dark transition-colors whitespace-nowrap"
            >
              Open Route Builder &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initMembersAuth } from "../lib/members-auth";
  initMembersAuth();
</script>
