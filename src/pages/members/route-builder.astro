  /* Override Leaflet z-index to stay below site header */
  #route-map :global(.leaflet-pane) { z-index: 1; }
  #route-map :global(.leaflet-top),
  #route-map :global(.leaflet-bottom) { z-index: 2; }

  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-tqcc-yellow);
    border: 2px solid var(--color-tqcc-black);
    cursor: pointer;
