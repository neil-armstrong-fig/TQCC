---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchNorthernIrelandCafes } from "../../lib/cafes";
import { fetchNorthernIrelandTowns } from "../../lib/towns";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const cafes = await fetchNorthernIrelandCafes();
const towns = await fetchNorthernIrelandTowns();
---

<BaseLayout
  title="Route Builder"
  description="Generate cycling loop routes on quiet roads for group rides."
  noindex={true}
>
  <section class="py-4">
    <div class="max-w-7xl mx-auto px-2 sm:px-4">
      <!-- Password gate (same as members page) -->
      <div id="password-gate" class="text-center py-20">
        <h1 class="text-4xl font-bold mb-4">Route Builder</h1>
        <p class="text-tqcc-gray mb-8">
          Enter the club password to access this page.
        </p>
        <form id="password-form" class="max-w-sm mx-auto">
          <div class="relative">
            <input
              type="password"
              id="password-input"
              placeholder="Password"
              class="w-full px-4 py-3 pr-12 border border-gray-300 rounded-lg text-center text-lg focus:outline-none focus:ring-2 focus:ring-tqcc-yellow"
            />
            <button
              type="button"
              id="toggle-password"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 focus:outline-none"
              aria-label="Toggle password visibility"
            >
              <svg id="eye-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <svg id="eye-closed" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
              </svg>
            </button>
          </div>
          <button
            type="submit"
            class="mt-4 w-full bg-tqcc-yellow text-tqcc-black font-bold px-6 py-3 rounded-lg hover:bg-tqcc-yellow-dark transition-colors"
          >
            Enter
          </button>
          <p id="error-message" class="mt-3 text-red-500 text-sm hidden">
            Incorrect password. Please try again.
          </p>
        </form>
      </div>

      <!-- Protected content -->
      <div id="members-content" class="hidden">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h1 class="text-4xl font-bold">Route Builder</h1>
            <p class="text-tqcc-gray mt-2">Generate loop routes on quiet roads for group rides</p>
          </div>
          <a
            href={`${baseUrl}/members`}
            class="text-sm text-tqcc-pink hover:text-tqcc-pink-light transition-colors"
          >
            &larr; Back to Members
          </a>
        </div>

        <!-- Route Builder App -->
        <div class="border border-gray-200 rounded-lg overflow-hidden bg-white shadow-sm">
          <!-- Map -->
          <div id="route-map" class="w-full relative" style="height: 60vh; min-height: 400px;"></div>
          <div class="px-4 py-2 bg-gray-50 border-b border-gray-200 flex items-center gap-3">
            <label class="flex items-center gap-2 cursor-pointer text-sm">
              <input type="checkbox" id="toggleCafesOnMap" class="accent-tqcc-pink w-4 h-4 cursor-pointer" />
              <span>Show cafes on map</span>
            </label>
            <span id="cafeMapCount" class="text-xs text-gray-400"></span>
            <button id="btnClearRoute"
              class="hidden ml-auto px-3 py-1 text-sm border border-red-400 text-red-400 rounded-lg hover:bg-red-400 hover:text-white transition-colors cursor-pointer">
              Clear Route
            </button>
          </div>

          <!-- Controls -->
          <div class="p-6 space-y-6">

            <!-- Starting Location -->
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wide text-tqcc-gray mb-3">Starting Location</h3>
              <div class="flex flex-wrap gap-2 mb-3">
                <button class="start-preset px-3 py-1.5 text-sm border border-gray-300 rounded-lg hover:border-tqcc-yellow transition-colors cursor-pointer"
                  data-name="The Big Fish" data-lat="54.6015" data-lon="-5.9218">The Big Fish</button>
                <button class="start-preset px-3 py-1.5 text-sm border border-gray-300 rounded-lg hover:border-tqcc-yellow transition-colors cursor-pointer"
                  data-name="Titanic Quarter Spar" data-lat="54.6045" data-lon="-5.9125">TQ Spar</button>
                <button class="start-preset px-3 py-1.5 text-sm border border-gray-300 rounded-lg hover:border-tqcc-yellow transition-colors cursor-pointer"
                  data-name="SD Bells" data-lat="54.5948" data-lon="-5.8552">SD Bells</button>
              </div>
              <input type="hidden" id="startName" value="Titanic Quarter Spar" />
              <input type="hidden" id="startLat" value="54.6045" />
              <input type="hidden" id="startLon" value="-5.9125" />
            </div>

            <hr class="border-gray-200" />

            <!-- Map Click Mode -->
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wide text-tqcc-gray mb-3">Map Click Mode</h3>
              <div class="grid grid-cols-3 gap-2">
                <button id="modeNone" class="map-mode-btn px-3 py-1.5 text-xs border-2 rounded-lg transition-all cursor-pointer text-center font-semibold border-gray-300 text-gray-500 active-map-mode" data-mode="none">Off</button>
                <button id="modeStart" class="map-mode-btn px-3 py-1.5 text-xs border-2 rounded-lg transition-all cursor-pointer text-center font-semibold border-tqcc-yellow text-tqcc-yellow" data-mode="start">Set Start</button>
                <button id="modeStop" class="map-mode-btn px-3 py-1.5 text-xs border-2 rounded-lg transition-all cursor-pointer text-center font-semibold border-tqcc-pink text-tqcc-pink" data-mode="stop">Add Stop</button>
              </div>
              <p id="mapModeHint" class="text-xs text-gray-400 mt-1">Map clicks disabled</p>
            </div>

            <hr class="border-gray-200" />

            <!-- Stops / Via-Points -->
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wide text-tqcc-gray mb-3">
                Stops
                <span class="text-xs font-normal normal-case tracking-normal text-gray-400 ml-1">(towns, cafes, scenic points)</span>
              </h3>
              <div id="stopsList" class="space-y-2 mb-3">
                <p class="text-sm text-gray-400" id="noStopsMsg">No stops added yet</p>
              </div>

              <!-- Town Search -->
              <div class="mb-3">
                <label for="townSearch" class="block text-sm font-medium mb-1">Search for a town</label>
                <div class="relative">
                  <input type="text" id="townSearch" placeholder="e.g. Downpatrick, Antrim, Lurgan..."
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-tqcc-yellow text-sm" />
                  <div id="townResults" class="hidden absolute z-50 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-48 overflow-y-auto">
                  </div>
                </div>
              </div>

              <!-- Cafe Search -->
              <div class="mb-3">
                <label for="cafeSearch" class="block text-sm font-medium mb-1">Search for a cafe</label>
                <div class="relative">
                  <input type="text" id="cafeSearch" placeholder="e.g. Fodder, The Shed, Eden..."
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-tqcc-pink text-sm" />
                  <div id="cafeResults" class="hidden absolute z-50 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-48 overflow-y-auto">
                  </div>
                </div>
                <p class="text-xs text-gray-400 mt-1">{cafes.length} cafes &middot; {towns.length} towns loaded</p>
              </div>

              <div class="flex flex-wrap gap-2">
                <button id="btnClearStops"
                  class="px-4 py-2 text-sm border border-red-300 text-red-400 rounded-lg hover:bg-red-500 hover:text-white hover:border-red-500 transition-colors cursor-pointer hidden">
                  Clear All Stops
                </button>
              </div>
            </div>

            <hr class="border-gray-200" />

            <!-- Wind & Ride Day -->
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wide text-tqcc-gray mb-3">Wind &amp; Ride Day</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="rideDay" class="block text-sm font-medium mb-1">Ride Day</label>
                  <select id="rideDay"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-tqcc-yellow text-sm">
                  </select>
                </div>
                <div>
                  <label for="rideTime" class="block text-sm font-medium mb-1">Start Time</label>
                  <input type="time" id="rideTime" value="09:00"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-tqcc-yellow text-sm" />
                </div>
              </div>
              <div id="windInfo" class="mt-3 hidden">
                <div class="flex items-center gap-3 bg-blue-50 border border-blue-200 rounded-lg p-3">
                  <div id="windArrow" class="flex-shrink-0" style="width:40px;height:40px;">
                    <svg viewBox="0 0 40 40" width="40" height="40">
                      <circle cx="20" cy="20" r="18" fill="#dbeafe" stroke="#93c5fd" stroke-width="1.5"/>
                      <polygon id="windArrowHead" points="20,4 26,28 20,23 14,28" fill="#2563eb" stroke="#1d4ed8" stroke-width="0.5"/>
                    </svg>
                  </div>
                  <div class="text-sm">
                    <p><strong id="windSummary">-</strong></p>
                    <p class="text-gray-500" id="windDetail">-</p>
                  </div>
                  <button id="btnUseWind"
                    class="ml-auto px-3 py-1.5 text-xs bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors cursor-pointer whitespace-nowrap">
                    Set Optimal Direction
                  </button>
                </div>
              </div>
              <button id="btnFetchWind"
                class="mt-3 px-4 py-2 text-sm border border-gray-300 rounded-lg hover:border-tqcc-yellow transition-colors cursor-pointer">
                Check Wind Forecast
              </button>

              <!-- Preferred Starting Direction -->
              <div class="mt-4">
                <label class="block text-sm font-medium mb-2">Preferred Starting Direction <span id="directionHint" class="text-xs font-normal text-gray-400"></span></label>
                <div class="flex items-center gap-4">
                  <!-- Compass -->
                  <div class="compass-container relative flex-shrink-0" style="width:120px;height:120px;">
                    <svg viewBox="0 0 120 120" class="w-full h-full">
                      <!-- Outer ring -->
                      <circle cx="60" cy="60" r="56" fill="none" stroke="#d1d5db" stroke-width="1.5" />
                      <!-- Compass segments (clickable) -->
                      <g id="compassSegments">
                        <path class="compass-seg" data-dir="N"  d="M60,60 L40.1,12.0 A52,52 0 0,1 79.9,12.0 Z" />
                        <path class="compass-seg" data-dir="NE" d="M60,60 L79.9,12.0 A52,52 0 0,1 108.0,40.1 Z" />
                        <path class="compass-seg" data-dir="E"  d="M60,60 L108.0,40.1 A52,52 0 0,1 108.0,79.9 Z" />
                        <path class="compass-seg" data-dir="SE" d="M60,60 L108.0,79.9 A52,52 0 0,1 79.9,108.0 Z" />
                        <path class="compass-seg" data-dir="S"  d="M60,60 L79.9,108.0 A52,52 0 0,1 40.1,108.0 Z" />
                        <path class="compass-seg" data-dir="SW" d="M60,60 L40.1,108.0 A52,52 0 0,1 12.0,79.9 Z" />
                        <path class="compass-seg" data-dir="W"  d="M60,60 L12.0,79.9 A52,52 0 0,1 12.0,40.1 Z" />
                        <path class="compass-seg" data-dir="NW" d="M60,60 L12.0,40.1 A52,52 0 0,1 40.1,12.0 Z" />
                      </g>
                      <!-- Center dot (Any) -->
                      <circle class="compass-seg compass-center" data-dir="any" cx="60" cy="60" r="14" />
                      <!-- Direction labels (centered on each segment at r=38 from center) -->
                      <text x="60" y="22" text-anchor="middle" dominant-baseline="central" class="compass-label">N</text>
                      <text x="87" y="33" text-anchor="middle" dominant-baseline="central" class="compass-label">NE</text>
                      <text x="98" y="60" text-anchor="middle" dominant-baseline="central" class="compass-label">E</text>
                      <text x="87" y="87" text-anchor="middle" dominant-baseline="central" class="compass-label">SE</text>
                      <text x="60" y="98" text-anchor="middle" dominant-baseline="central" class="compass-label">S</text>
                      <text x="33" y="87" text-anchor="middle" dominant-baseline="central" class="compass-label">SW</text>
                      <text x="22" y="60" text-anchor="middle" dominant-baseline="central" class="compass-label">W</text>
                      <text x="33" y="33" text-anchor="middle" dominant-baseline="central" class="compass-label">NW</text>
                      <!-- Compass needle indicator -->
                      <line id="compassNeedle" x1="60" y1="60" x2="60" y2="16" stroke="#E91E8C" stroke-width="2.5" stroke-linecap="round" class="hidden" />
                    </svg>
                  </div>
                  <!-- Dropdown -->
                  <div class="flex-1">
                    <select id="directionSelect" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-tqcc-yellow text-sm">
                      <option value="any" selected>No preference</option>
                      <option value="N">North</option>
                      <option value="NE">North-East</option>
                      <option value="E">East</option>
                      <option value="SE">South-East</option>
                      <option value="S">South</option>
                      <option value="SW">South-West</option>
                      <option value="W">West</option>
                      <option value="NW">North-West</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <hr class="border-gray-200" />

            <!-- Route Preferences -->
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wide text-tqcc-gray mb-3">Route Preferences</h3>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Distance -->
                <div>
                  <label for="distance" class="block text-sm font-medium mb-1">Target Distance</label>
                  <div class="flex items-center gap-3">
                    <input type="range" id="distance" min="5" max="322" value="40" step="1"
                      class="flex-1 h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-tqcc-yellow" />
                    <div class="flex items-center gap-1">
                      <input type="number" id="distanceNumber" min="5" max="322" value="40" step="1"
                        class="w-16 px-2 py-1 border border-gray-300 rounded-lg text-sm text-center focus:outline-none focus:ring-2 focus:ring-tqcc-yellow" />
                      <span id="distUnitLabel" class="text-xs text-tqcc-pink font-semibold">km</span>
                    </div>
                  </div>
                </div>

                <!-- Road Avoidance -->
                <div>
                  <label for="difficulty" class="block text-sm font-medium mb-1">Road Avoidance</label>
                  <input type="range" id="difficulty" min="1" max="3" value="2" step="1"
                    class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-tqcc-yellow" />
                  <div class="flex justify-between text-xs text-gray-400 mt-1">
                    <span>Some main roads</span>
                    <span id="diffLabel" class="font-semibold text-tqcc-pink">Low traffic</span>
                    <span>Very quiet</span>
                  </div>
                </div>
              </div>
            </div>

            <hr class="border-gray-200" />

            <!-- Routing Profile -->
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wide text-tqcc-gray mb-3">Route Type</h3>
              <p class="text-xs text-gray-400 mb-2">All routes avoid main roads and prioritise quiet, safe roads</p>
              <div class="grid grid-cols-3 gap-2">
                <button class="profile-btn px-3 py-2 text-sm border-2 rounded-lg transition-all cursor-pointer text-center font-semibold border-tqcc-yellow bg-tqcc-yellow text-tqcc-black active-profile" data-profile="flat">Flat</button>
                <button class="profile-btn px-3 py-2 text-sm border-2 rounded-lg transition-all cursor-pointer text-center font-semibold border-tqcc-pink bg-tqcc-pink text-white" data-profile="mixed">Mixed</button>
                <button class="profile-btn px-3 py-2 text-sm border-2 rounded-lg transition-all cursor-pointer text-center font-semibold border-tqcc-black bg-tqcc-black text-white" data-profile="hilly">Hilly</button>
              </div>
            </div>

            <hr class="border-gray-200" />

            <!-- Rider Info -->
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wide text-tqcc-gray mb-3">Rider Info</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="avgSpeed" class="block text-sm font-medium mb-1">
                    Avg Speed (<span id="speedUnitLabel" class="pace-string" data-pace="mph">mph</span>)
                  </label>
                  <input type="number" id="avgSpeed" value="15" min="5" max="30"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-tqcc-yellow text-sm" />
                </div>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-wrap gap-3">
              <button id="btnGenerate"
                class="flex-1 bg-tqcc-yellow text-tqcc-black font-bold px-6 py-3 rounded-lg hover:bg-tqcc-yellow-dark transition-colors cursor-pointer">
                Generate Route
              </button>
              <button id="btnDownload" disabled
                class="px-6 py-3 border-2 border-tqcc-yellow text-tqcc-yellow font-bold rounded-lg hover:bg-tqcc-yellow hover:text-tqcc-black transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:hover:text-tqcc-yellow">
                Download GPX
              </button>
              <a id="btnStrava" href="https://www.strava.com/routes/new" target="_blank" rel="noopener noreferrer"
                class="hidden px-6 py-3 border-2 border-[#FC4C02] text-[#FC4C02] font-bold rounded-lg hover:bg-[#FC4C02] hover:text-white transition-colors text-center">
                Open Strava Routes
              </a>
            </div>

            <!-- Strava instructions (shown after route generated) -->
            <div id="stravaInstructions" class="hidden">
              <details class="border border-gray-200 rounded-lg bg-gray-50">
                <summary class="p-3 cursor-pointer text-sm font-semibold text-tqcc-gray hover:text-tqcc-black">
                  How to import into Strava
                </summary>
                <div class="px-4 pb-4 text-sm text-tqcc-gray space-y-3">
                  <div>
                    <p class="font-semibold mb-1">On desktop:</p>
                    <ol class="list-decimal list-inside space-y-1">
                      <li>Click <strong>Download GPX</strong> above to save the file</li>
                      <li>Click <strong>Open Strava Routes</strong> (or go to strava.com/routes/new)</li>
                      <li>In the Strava route builder, click the <strong>upload icon</strong> (top-right of the map toolbar)</li>
                      <li>Select the downloaded GPX file</li>
                      <li>Click <strong>Save</strong> to add it to your routes</li>
                    </ol>
                  </div>
                  <div>
                    <p class="font-semibold mb-1">On phone:</p>
                    <ol class="list-decimal list-inside space-y-1">
                      <li>Tap <strong>Download GPX</strong> &mdash; the file saves to your Downloads folder</li>
                      <li>Open the <strong>Strava app</strong> and go to <strong>Maps</strong> tab</li>
                      <li>Tap <strong>Routes</strong> (bottom of the screen), then the <strong>+</strong> icon</li>
                      <li>Tap <strong>Import GPX/TCX</strong> (or use the upload icon at the top)</li>
                      <li>Browse to your Downloads and select the GPX file</li>
                    </ol>
                    <p class="text-xs text-gray-400 mt-1">Note: GPX import in the Strava mobile app requires a Strava subscription. Free users can upload via the desktop site on their phone's browser instead.</p>
                  </div>
                </div>
              </details>
            </div>

            <!-- Status -->
            <div id="status" class="text-sm min-h-[1.5rem]"></div>

            <!-- Route Info (hidden until route generated) -->
            <div id="routeInfo" class="hidden border border-gray-200 rounded-lg p-4 bg-gray-50">
              <h3 class="text-sm font-semibold uppercase tracking-wide text-tqcc-gray mb-3">Route Details</h3>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                <div>
                  <span class="text-gray-400">Distance</span>
                  <p class="font-bold text-lg" id="statDist">-</p>
                </div>
                <div>
                  <span class="text-gray-400">Est. Time</span>
                  <p class="font-bold text-lg" id="statTime">-</p>
                </div>
                <div>
                  <span class="text-gray-400">Ascent</span>
                  <p class="font-bold text-lg" id="statAscent">-</p>
                </div>
                <div>
                  <span class="text-gray-400">Profile</span>
                  <p class="font-bold text-lg" id="statProfile">-</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cafe data embedded at build time, refreshed daily via cron -->
  <script is:inline define:vars={{ cafes, towns }}>
    window.__niCafes = cafes;
    window.__niTowns = towns;
  </script>
</BaseLayout>

<style>
  /* Compass */
  .compass-seg {
    fill: #f3f4f6;
    stroke: #d1d5db;
    stroke-width: 0.5;
    cursor: pointer;
    transition: fill 0.15s;
  }
  .compass-seg:hover {
    fill: #fef3c7;
  }
  .compass-seg.active-dir {
    fill: var(--color-tqcc-yellow);
  }
  .start-preset.active-dir {
    border-color: var(--color-tqcc-yellow);
    background-color: var(--color-tqcc-yellow);
    color: var(--color-tqcc-black);
    font-weight: 600;
  }
  .compass-seg.wind-recommended {
    stroke: #3b82f6;
    stroke-width: 2;
  }
  .compass-center {
    fill: #e5e7eb;
    stroke: #9ca3af;
  }
  .compass-center:hover {
    fill: #d1d5db;
  }
  .compass-center.active-dir {
    fill: var(--color-tqcc-yellow);
    stroke: var(--color-tqcc-black);
  }
  .compass-label {
    font-size: 9px;
    font-weight: 600;
    fill: #6b7280;
    pointer-events: none;
    user-select: none;
  }
  .profile-btn:not(.active-profile) {
    opacity: 0.4;
  }
  .map-mode-btn:not(.active-map-mode) {
    opacity: 0.4;
  }
  .map-mode-btn.active-map-mode {
    opacity: 1;
    font-weight: 700;
  }
  #modeNone.active-map-mode {
    background-color: var(--color-gray-200, #e5e7eb);
    border-color: var(--color-gray-400, #9ca3af);
