  .wind-recommended {
    box-shadow: 0 0 0 2px #3b82f6;
  }
  /* Map click mode cursors — crosshair for placing points */
  .map-mode-start,
  .map-mode-start :global(.leaflet-container),
  .map-mode-start :global(.leaflet-grab),
  .map-mode-stop,
