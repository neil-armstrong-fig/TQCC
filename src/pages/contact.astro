---
import BaseLayout from "../layouts/BaseLayout.astro";
import { socialLinks } from "../data/navigation";
import { getLastUpdated } from "../lib/git-date";
const lastUpdated = getLastUpdated("src/pages/contact.astro");
---

<BaseLayout
  title="Contact"
  description="Contact Titanic Quarter Cycling Club in Belfast. Get in touch about joining our cycling club, weekly rides, or cycling events in Belfast, Northern Ireland."
  lastUpdated={lastUpdated}
>
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4">
      <h1 class="text-4xl font-bold mb-4">Contact TQCC Belfast</h1>
      <p class="text-tqcc-gray text-lg mb-10">
        Questions about joining our Belfast cycling club, membership, or group rides?
        Get in touch using the details below.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-10">
        <div>
          <h2 class="text-2xl font-bold mb-4">Where does TQCC meet?</h2>
          <p class="text-tqcc-gray mb-2">
            <strong>Meeting Point:</strong> SPAR Titanic Quarter<br />
            Titanic Quarter, Belfast, Northern Ireland
          </p>
          <p class="text-tqcc-gray">
            All rides depart from the SPAR in Belfast Titanic Quarter.
          </p>
        </div>

        <div>
          <h2 class="text-2xl font-bold mb-4">Email</h2>
          <a
            href="mailto:titanicquartercc@gmail.com"
            class="text-tqcc-pink hover:text-tqcc-pink-light transition-colors text-lg"
          >
            titanicquartercc@gmail.com
          </a>
        </div>

        <div>
          <h2 class="text-2xl font-bold mb-4">Social Media</h2>
          <div class="space-y-3">
            {
              socialLinks.filter((link) => link.platform !== "GitHub").map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 text-tqcc-gray hover:text-tqcc-pink transition-colors"
                >
                  {link.platform === "Instagram" && (
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                    </svg>
                  )}
                  {link.platform === "Strava" && (
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169" />
                    </svg>
                  )}
                  <span class="font-medium">{link.platform}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Map -->
      <div class="rounded-lg overflow-hidden h-80 bg-tqcc-gray-light">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2311.89!2d-5.9124913!3d54.6044995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x486109aebda60a5f%3A0xa865162525e04631!2sSPAR%20Titanic!5e0!3m2!1sen!2suk!4v1700000000000!5m2!1sen!2suk"
          width="100%"
          height="100%"
          style="border:0"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
