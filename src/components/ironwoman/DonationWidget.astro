---
interface Props {
  amount: number;
  giftAid: number;
  target: number;
  asOf: string;
  donateUrl: string;
}

const { amount, giftAid, target, asOf, donateUrl } = Astro.props;
const raised = amount + giftAid;
const percent = Math.min(100, (raised / target) * 100);
const remaining = Math.max(0, target - raised);

const gbp = (n: number) =>
  `£${n.toLocaleString("en-GB", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const gbpWhole = (n: number) => `£${Math.round(n).toLocaleString("en-GB")}`;
---

<div
  class="ironwoman-widget bg-tqcc-black text-white rounded-2xl p-6 md:p-8 mb-12 shadow-lg"
>
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2 mb-6">
    <div>
      <p class="text-tqcc-yellow font-semibold text-sm uppercase tracking-wide">Raised so far</p>
      <p class="text-4xl md:text-5xl font-bold" data-total>{gbp(raised)}</p>
    </div>
    <p class="text-white/70 text-sm sm:text-right">
      of {gbpWhole(target)} target<br />
      <span class="text-white/50">{gbp(amount)} donated + {gbp(giftAid)} Gift Aid, as of {asOf}</span>
    </p>
  </div>

  <div
    class="relative h-6 rounded-full bg-white/10 overflow-hidden"
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={Math.round(percent)}
    aria-label="Fundraising progress towards target"
  >
    <div
      class="iw-fill absolute inset-y-0 left-0 rounded-full bg-gradient-to-r from-tqcc-pink to-tqcc-pink-light"
      style={`width: ${percent}%`}
      data-fill
    >
    </div>
  </div>
  <div class="flex justify-between text-xs text-white/60 mt-2 mb-8">
    <span data-percent>{percent.toFixed(1)}% of the way there</span>
    <span data-remaining>{gbpWhole(remaining)} to go</span>
  </div>

  <div class="border-t border-white/10 pt-6">
    <a
      href={donateUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block bg-tqcc-yellow text-tqcc-black font-bold px-6 py-3 rounded-lg hover:bg-tqcc-yellow-dark transition-colors"
    >
      Donate on Givestar &rarr;
    </a>
    <p class="text-white/50 text-xs mt-2">
      Donations are made securely on Givestar. You'll choose your amount and Gift Aid there.
    </p>
  </div>
</div>

<style>
  .iw-fill {
    transition: width 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .iw-fill {
      transition: none;
    }
  }
</style>

<script>
  // Animate the bar filling in when it scrolls into view.
  document.querySelectorAll<HTMLElement>(".ironwoman-widget").forEach((root) => {
    const fill = root.querySelector<HTMLElement>("[data-fill]")!;
    const finalWidth = fill.style.width;
    fill.style.width = "0%";
    const reveal = () => (fill.style.width = finalWidth);
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            reveal();
            io.disconnect();
          }
        },
        { threshold: 0.4 },
      );
      io.observe(root);
    } else {
      reveal();
    }
  });
</script>
