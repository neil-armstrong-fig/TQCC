---
import Navigation from "./Navigation.astro";
import UnitToggle from "./UnitToggle.astro";
import { mainNavigation } from "../../data/navigation";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="bg-tqcc-black sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 py-4 flex items-center">
    <a href={baseUrl || "/"} data-astro-prefetch class="flex items-center gap-3 group">
      <img
        src={`${baseUrl}/images/badge.png`}
        alt="TQCC Badge"
        width="40"
        height="40"
        class="rounded-full"
      />
      <span
        class="text-tqcc-yellow font-bold text-lg hidden sm:inline group-hover:text-tqcc-yellow-light transition-colors"
      >
        TQCC
      </span>
    </a>

    <Navigation />

    <div class="hidden lg:block ml-auto">
      <UnitToggle />
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden text-white p-2 ml-auto"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="hidden lg:hidden bg-tqcc-black-light border-t border-white/10"
  >
    <div class="px-4 py-4 space-y-2">
      {
        mainNavigation.map((item) => {
          const fullHref = item.href === "/" ? (baseUrl || "/") : `${baseUrl}${item.href}`;
          return (
            <a
              href={fullHref}
              class:list={[
                item.highlight
                  ? "block text-tqcc-black bg-tqcc-pink font-bold py-2 px-3 rounded-md hover:bg-tqcc-pink/80 transition-colors"
                  : "block text-white py-2 hover:text-tqcc-yellow transition-colors",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }

      <!-- Unit toggle in mobile menu -->
      <div class="pt-2 border-t border-white/10">
        <UnitToggle />
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    if (btn && menu) {
      btn.addEventListener("click", () => {
        const expanded = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!expanded));
        menu.classList.toggle("hidden");
      });
    }
  });
</script>
