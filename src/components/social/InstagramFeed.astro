---
import { getInstagramPosts } from "../../lib/instagram";

interface Props {
  limit?: number;
}

const { limit = 12 } = Astro.props;
const posts = await getInstagramPosts(limit);
---

<section class="py-12">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold">Latest on Instagram</h2>
      <a
        href="https://www.instagram.com/titanicquartercc/"
        class="text-tqcc-pink hover:text-tqcc-pink-light font-medium transition-colors"
        target="_blank"
        rel="noopener noreferrer"
      >
        Follow @titanicquartercc &rarr;
      </a>
    </div>

    {
      posts.length > 0 ? (
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {posts.map((post) => (
            <div
              class="group relative aspect-square overflow-hidden rounded-lg bg-tqcc-gray-light cursor-pointer"
              data-permalink={post.permalink}
              data-media-type={post.media_type}
              data-media-url={post.media_type === "VIDEO" ? post.media_url : undefined}
              data-image-url={post.media_type !== "VIDEO" ? post.media_url : undefined}
              data-caption={post.caption || ""}
              data-timestamp={post.timestamp}
            >
              <img
                src={
                  post.media_type === "VIDEO"
                    ? post.thumbnail_url
                    : post.media_url
                }
                alt={post.caption?.slice(0, 200) || "Instagram post from TQCC"}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              {post.media_type === "VIDEO" && (
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity z-10">
                  <div class="w-14 h-14 rounded-full bg-black/60 flex items-center justify-center">
                    <svg class="w-6 h-6 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>
              )}
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors flex items-end z-20">
                <p class="text-white text-sm p-3 opacity-0 group-hover:opacity-100 transition-opacity overflow-y-auto max-h-full">
                  {post.caption}
                </p>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="bg-tqcc-gray-light rounded-lg p-8 text-center">
          <p class="text-tqcc-gray">
            Follow us on{" "}
            <a
              href="https://www.instagram.com/titanicquartercc/"
              class="text-tqcc-pink underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram
            </a>{" "}
            for the latest photos and updates.
          </p>
        </div>
      )
    }
  </div>
</section>

<div id="instagram-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4" role="dialog" aria-modal="true">
  <button id="instagram-modal-close" class="absolute top-4 right-4 text-white hover:text-tqcc-yellow transition-colors z-10" aria-label="Close">
    <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <div class="max-w-4xl w-full max-h-[90vh] flex flex-col md:flex-row bg-tqcc-black rounded-lg overflow-hidden">
    <div id="instagram-modal-media" class="flex-shrink-0 flex items-center justify-center bg-black md:w-2/3 max-h-[60vh] md:max-h-[90vh]"></div>
    <div class="md:w-1/3 p-4 overflow-y-auto">
      <p id="instagram-modal-date" class="text-tqcc-gray text-xs mb-3"></p>
      <p id="instagram-modal-caption" class="text-white text-sm whitespace-pre-line"></p>
      <a id="instagram-modal-link" href="#" target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-tqcc-pink hover:text-tqcc-pink-light text-sm font-medium transition-colors">
        View on Instagram &rarr;
      </a>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('instagram-modal')!;
  const modalMedia = document.getElementById('instagram-modal-media')!;
  const modalCaption = document.getElementById('instagram-modal-caption')!;
  const modalLink = document.getElementById('instagram-modal-link') as HTMLAnchorElement;
  const modalDate = document.getElementById('instagram-modal-date')!;
  const modalClose = document.getElementById('instagram-modal-close')!;

  function openModal(card: HTMLDivElement) {
    const mediaType = card.dataset.mediaType;
    const permalink = card.dataset.permalink || '#';
    const caption = card.dataset.caption || '';

    modalMedia.innerHTML = '';
    const timestamp = card.dataset.timestamp;
    modalDate.textContent = timestamp
      ? new Date(timestamp).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
      : '';
    modalCaption.textContent = caption;
    modalLink.href = permalink;

    if (mediaType === 'VIDEO') {
      const savedMuted = localStorage.getItem('ig-video-muted');
      const savedVolume = localStorage.getItem('ig-video-volume');

      const video = document.createElement('video');
      video.src = card.dataset.mediaUrl || '';
      video.controls = true;
      video.autoplay = true;
      video.muted = savedMuted === null ? true : savedMuted === 'true';
      video.volume = savedVolume === null ? 1 : parseFloat(savedVolume);
      video.playsInline = true;
      video.className = 'w-full max-h-[60vh] md:max-h-[90vh] object-contain';

      video.addEventListener('volumechange', () => {
        localStorage.setItem('ig-video-muted', String(video.muted));
        localStorage.setItem('ig-video-volume', String(video.volume));
      });

      modalMedia.appendChild(video);
    } else {
      const img = document.createElement('img');
      img.src = card.dataset.imageUrl || '';
      img.alt = caption.slice(0, 200) || 'Instagram post from TQCC';
      img.className = 'w-full max-h-[60vh] md:max-h-[90vh] object-contain';
      modalMedia.appendChild(img);
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    const video = modalMedia.querySelector('video');
    if (video) video.pause();
  }

  document.querySelectorAll<HTMLDivElement>('[data-permalink]').forEach((card) => {
    card.addEventListener('click', () => openModal(card));
  });

  modalClose.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
  });
</script>
